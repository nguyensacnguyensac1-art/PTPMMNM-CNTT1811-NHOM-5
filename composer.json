{
    "name": "releasehub/releasehub",
    "description": "ReleaseHub - Hệ thống theo dõi lỗi và quản lý kế hoạch phát hành phần mềm (BTL Phát triển phần mềm mã nguồn mở, đề tài 5)",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "ext-mbstring": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6 || ^10.5"
    },
    "autoload": {
        "psr-4": {
            "ReleaseHub\\": "app/",
            "ReleaseHub\\Database\\": "database/"
        },
        "files": ["app/Support/helpers.php"]
    },
    "autoload-dev": {
        "psr-4": { "ReleaseHub\\Tests\\": "tests/" }
    },
    "scripts": {
        "test": "phpunit",
        "migrate": "php bin/migrate.php",
        "seed": "php bin/seed.php"
    },
    "config": { "sort-packages": true, "optimize-autoloader": true },
    "minimum-stability": "stable",
    "prefer-stable": true
}
