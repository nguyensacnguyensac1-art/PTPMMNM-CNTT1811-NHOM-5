# ReleaseHub - bảo vệ mã nguồn nội bộ khi đặt cả dự án trong htdocs.
# Cần: mod_rewrite bật và AllowOverride All (mặc định của XAMPP cho htdocs).
Options -Indexes
DirectoryIndex index.php
<IfModule mod_rewrite.c>
    RewriteEngine On
    # Chặn các thư mục nội bộ
    RewriteRule ^(app|bin|database|docs|storage|tests|vendor|views|\.git|\.github)(/|$) - [F,L,NC]
</IfModule>
# Chặn tệp nhạy cảm theo tên/đuôi
<FilesMatch "(^\.|\.(env|sql|log|md|lock|json|xml|dist|php-cs|yml|yaml|sh|ini)$|^composer\.|^LICENSE$|^phpunit)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
